SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
CRON_SECRET=your-cron-secret
# Optional public URL override. Railway's RAILWAY_PUBLIC_DOMAIN is detected automatically.
# PUBLIC_BASE_URL=https://your-service.up.railway.app

# Fanvue developer app (server only). Register this exact redirect URI in Fanvue.
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_REDIRECT_URI=https://tigerbot.info/api/public/fanvue/callback
# Set a private 32-byte key encoded as base64; never commit the generated key.
FANVUE_TOKEN_ENCRYPTION_KEY=
# Keep false until Fanvue has approved the account and its products for checkout links.
FANVUE_LIVE_CHECKOUT_ENABLED=false

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional direct Postgres connection for Drizzle CLI; use your database password.
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
